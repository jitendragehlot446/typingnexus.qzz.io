---
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} Typing Nexus. All rights reserved.
	<div class="social-links">
		<a href="https://typingnexus.in" target="_blank" class="caption">
			Practice Portal: typingnexus.in
		</a>
	</div>
</footer>
<style>
	footer {
		padding: 3rem 1rem;
		border-top: 1px solid var(--border-color);
		background: #09090b;
		color: var(--text-muted);
		text-align: center;
		font-size: 0.95rem;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1.5rem;
		margin-top: 1.5rem;
	}
	.social-links a {
		text-decoration: none;
		color: var(--text-muted);
		transition: color 0.2s ease;
	}
	.social-links a:hover {
		color: var(--text-primary);
	}
</style>
