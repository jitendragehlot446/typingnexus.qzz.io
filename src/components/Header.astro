---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="top-nav">
	<nav>
		<h2>
			<a href="/" class="logo">
				<img src="/logo.jpg" alt="Typing Nexus Logo" class="logo-img" />
				Typing Nexus
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/guides">Guides</HeaderLink>
			<HeaderLink href="/calculator">Calculator</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="cta-pair">
			<a href="/blog" class="button-secondary">Read Blogs</a>
			<a href="https://typingnexus.in" target="_blank" class="button-primary">Free Mock Test</a>
		</div>
	</nav>
</header>

<style>
	.top-nav {
		position: sticky;
		top: 0;
		height: 56px;
		background-color: var(--colors-canvas);
		border-bottom: 1px solid var(--colors-hairline);
		z-index: 100;
		display: flex;
		align-items: center;
		padding: 0 var(--spacing-lg);
	}
	nav {
		width: 1280px;
		max-width: 100%;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	h2 {
		margin: 0;
	}
	.logo {
		font-family: var(--font-sans);
		font-weight: 800;
		font-size: 20px;
		letter-spacing: -0.8px;
		color: var(--colors-primary);
		text-decoration: none;
		display: flex;
		align-items: center;
		gap: var(--spacing-xs);
	}
	.logo-img {
		height: 32px;
		width: 32px;
		object-fit: cover;
		border-radius: var(--rounded-sm);
		border: 1px solid var(--colors-hairline);
	}
	.internal-links {
		display: flex;
		gap: var(--spacing-md);
	}
	.internal-links :global(a) {
		font-family: var(--font-sans);
		font-size: 16px;
		font-weight: 330;
		color: var(--colors-primary);
		text-decoration: none;
		padding: var(--spacing-xxs) var(--spacing-xs);
		border-radius: var(--rounded-pill);
		transition: background-color 0.15s ease;
	}
	.internal-links :global(a:hover) {
		background-color: var(--colors-hairline-soft);
	}
	.internal-links :global(a.active) {
		font-weight: 540;
		background-color: var(--colors-hairline);
	}
	.cta-pair {
		display: flex;
		align-items: center;
		gap: var(--spacing-xs);
	}
	.cta-pair .button-primary {
		font-size: 14px;
		font-weight: 480;
		padding: 6px 14px;
	}
	.cta-pair .button-secondary {
		font-size: 14px;
		font-weight: 480;
		padding: 5px 12px 7px;
		border: 1px solid var(--colors-hairline);
	}
	@media (max-width: 768px) {
		.cta-pair {
			display: none;
		}
	}
</style>
