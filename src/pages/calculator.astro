---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const toolSchema = {
	"@context": "https://schema.org",
	"@type": "WebApplication",
	"name": "Typing Speed & KDPH Calculator for Government Exams",
	"url": "https://blog.typingnexus.in/calculator/",
	"applicationCategory": "EducationalApplication",
	"operatingSystem": "All",
	"description": "Free online typing speed calculator to compute Gross WPM, Net WPM, Accuracy Percentage, KDPH, and pass/fail qualification status for SSC CGL, SSC CHSL, RRB NTPC, and High Court exams.",
	"offers": {
		"@type": "Offer",
		"price": "0",
		"priceCurrency": "INR"
	}
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead 
			title="Typing Speed & KDPH Calculator: Gross vs Net WPM (Govt Exams) | Typing Nexus" 
			description="Free interactive typing speed calculator to calculate Gross WPM, Net WPM, Accuracy %, KDPH, and error penalty for SSC CGL, SSC CHSL, RRB NTPC, High Court, and Police exams." 
		/>
		<script type="application/ld+json" set:html={JSON.stringify(toolSchema)} />
		<style>
			main {
				width: 1280px;
				max-width: calc(100% - 2 * var(--spacing-xxl));
				margin: 0 auto;
			}
			.calc-hero {
				text-align: center;
				margin-bottom: var(--spacing-xl);
				border-bottom: 1px solid var(--colors-hairline);
				padding-bottom: var(--spacing-xl);
			}
			.calc-hero .eyebrow {
				display: block;
				margin-bottom: var(--spacing-sm);
				opacity: 0.8;
			}
			.calc-container {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: var(--spacing-xl);
				margin-bottom: var(--spacing-section);
			}
			@media (max-width: 900px) {
				.calc-container {
					grid-template-columns: 1fr;
				}
			}
			.calc-card {
				background-color: var(--colors-canvas);
				border: 1px solid var(--colors-hairline);
				border-radius: var(--rounded-lg);
				padding: var(--spacing-xl);
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
			}
			.calc-form-group {
				margin-bottom: var(--spacing-lg);
			}
			.calc-form-group label {
				display: block;
				font-size: 15px;
				font-weight: 600;
				margin-bottom: var(--spacing-xs);
				color: var(--colors-primary);
			}
			.calc-form-group .hint {
				font-size: 13px;
				opacity: 0.7;
				margin-bottom: var(--spacing-xs);
				display: block;
			}
			.calc-input {
				width: 100%;
				padding: 12px 16px;
				font-size: 18px;
				font-family: var(--font-mono);
				border: 1px solid var(--colors-hairline);
				border-radius: var(--rounded-sm);
				background-color: var(--colors-surface-soft);
				color: var(--colors-primary);
				transition: border-color 0.2s ease, box-shadow 0.2s ease;
			}
			.calc-input:focus {
				outline: none;
				border-color: var(--colors-primary);
				background-color: var(--colors-canvas);
				box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.05);
			}
			.results-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: var(--spacing-md);
				margin-bottom: var(--spacing-lg);
			}
			.result-stat-box {
				background: var(--colors-surface-soft);
				border: 1px solid var(--colors-hairline);
				border-radius: var(--rounded-md);
				padding: var(--spacing-md);
				text-align: center;
			}
			.result-stat-label {
				font-size: 13px;
				font-family: var(--font-mono);
				text-transform: uppercase;
				opacity: 0.7;
				margin-bottom: var(--spacing-xxs);
				letter-spacing: 0.05em;
			}
			.result-stat-val {
				font-size: 32px;
				font-weight: 700;
				font-family: var(--font-sans);
				color: var(--colors-primary);
				letter-spacing: -0.5px;
			}
			.result-stat-val.highlight {
				color: var(--colors-semantic-success);
			}
			.exam-qualify-card {
				background: var(--colors-block-cream);
				border: 1px solid var(--colors-hairline);
				border-radius: var(--rounded-md);
				padding: var(--spacing-lg);
				margin-top: var(--spacing-lg);
			}
			.exam-qualify-card h3 {
				font-size: 18px;
				margin-bottom: var(--spacing-md);
			}
			.exam-status-item {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 8px 0;
				border-bottom: 1px solid rgba(0, 0, 0, 0.08);
				font-size: 14px;
			}
			.exam-status-item:last-child {
				border-bottom: none;
			}
			.status-pill {
				padding: 4px 12px;
				border-radius: var(--rounded-pill);
				font-size: 12px;
				font-weight: 600;
				font-family: var(--font-mono);
				text-transform: uppercase;
			}
			.status-pass {
				background-color: #d1fae5;
				color: #065f46;
			}
			.status-fail {
				background-color: #fee2e2;
				color: #991b1b;
			}
			.info-section {
				margin-top: var(--spacing-xl);
				border-top: 1px solid var(--colors-hairline);
				padding-top: var(--spacing-xl);
			}
			.info-section h2 {
				margin-bottom: var(--spacing-md);
			}
			.info-section p {
				margin-bottom: var(--spacing-md);
				line-height: 1.6;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="calc-hero">
				<span class="eyebrow">Official Formula Engine</span>
				<h1 class="display-lg">Typing Speed & KDPH Calculator</h1>
				<p class="body-lg" style="max-width: 700px; margin: var(--spacing-sm) auto 0;">
					Calculate your Gross WPM, Net WPM, Accuracy %, and Key Depressions Per Hour (KDPH) according to official SSC, Railway, and High Court examination evaluation norms.
				</p>
			</section>

			<section class="calc-container">
				<!-- Input Panel -->
				<div class="calc-card">
					<h2 class="headline" style="margin-bottom: var(--spacing-lg);">Enter Test Statistics</h2>
					
					<div class="calc-form-group">
						<label for="char-count">Total Characters / Key Depressions Typed</label>
						<span class="hint">Includes letters, spaces, and punctuation (e.g. 1750 for 35 WPM in 10 mins)</span>
						<input type="number" id="char-count" class="calc-input" value="1850" min="0" />
					</div>

					<div class="calc-form-group">
						<label for="duration">Test Duration (Minutes)</label>
						<span class="hint">Standard government exam duration is 10 or 15 minutes</span>
						<input type="number" id="duration" class="calc-input" value="10" min="1" max="60" />
					</div>

					<div class="calc-form-group">
						<label for="full-mistakes">Full Mistakes (Word Omissions / Additions / Substitutions)</label>
						<span class="hint">Penalty: 1.0 Word per full mistake</span>
						<input type="number" id="full-mistakes" class="calc-input" value="4" min="0" />
					</div>

					<div class="calc-form-group">
						<label for="half-mistakes">Half Mistakes (Spelling / Capitalization / Spacing)</label>
						<span class="hint">Penalty: 0.5 Word per half mistake</span>
						<input type="number" id="half-mistakes" class="calc-input" value="6" min="0" />
					</div>
				</div>

				<!-- Output Panel -->
				<div class="calc-card">
					<h2 class="headline" style="margin-bottom: var(--spacing-lg);">Live Evaluation Results</h2>

					<div class="results-grid">
						<div class="result-stat-box">
							<div class="result-stat-label">Net Speed</div>
							<div class="result-stat-val highlight" id="net-wpm">30.0 WPM</div>
						</div>
						<div class="result-stat-box">
							<div class="result-stat-label">Gross Speed</div>
							<div class="result-stat-val" id="gross-wpm">37.0 WPM</div>
						</div>
						<div class="result-stat-box">
							<div class="result-stat-label">Net Accuracy</div>
							<div class="result-stat-val" id="accuracy">95.4%</div>
						</div>
						<div class="result-stat-box">
							<div class="result-stat-label">Calculated KDPH</div>
							<div class="result-stat-val" id="kdph">11,100</div>
						</div>
					</div>

					<div class="exam-qualify-card">
						<h3>Exam Qualification Status</h3>
						<div id="exam-status-list">
							<!-- Dynamic status will be rendered here -->
						</div>
					</div>

					<div style="margin-top: var(--spacing-lg); text-align: center;">
						<a href="https://typingnexus.in" target="_blank" class="button-primary" style="display: inline-block; width: 100%;">
							Practice Live Mock Tests on Typing Nexus →
						</a>
					</div>
				</div>
			</section>

			<!-- Mathematical Explanation -->
			<section class="info-section">
				<h2>How Government Exam Speeds are Calculated</h2>
				<p>
					In all central and state government typing tests (SSC, RRB, Courts, and Police), speed is measured using the <strong>5-Keystroke Standard</strong>, where 5 key depressions (including spaces and punctuation) represent 1 standard word.
				</p>
				<div class="prose">
					<blockquote>
						<strong>Gross WPM</strong> = <code>(Total Characters Typed / 5) / Time (Minutes)</code><br />
						<strong>Total Error Words</strong> = <code>Full Mistakes + (Half Mistakes × 0.5)</code><br />
						<strong>Net WPM</strong> = <code>Gross WPM - (Total Error Words / Time)</code><br />
						<strong>KDPH (Key Depressions Per Hour)</strong> = <code>(Total Characters / Time) × 60</code>
					</blockquote>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			const charInput = document.getElementById('char-count') as HTMLInputElement;
			const durationInput = document.getElementById('duration') as HTMLInputElement;
			const fullMistakesInput = document.getElementById('full-mistakes') as HTMLInputElement;
			const halfMistakesInput = document.getElementById('half-mistakes') as HTMLInputElement;

			const netWpmEl = document.getElementById('net-wpm');
			const grossWpmEl = document.getElementById('gross-wpm');
			const accuracyEl = document.getElementById('accuracy');
			const kdphEl = document.getElementById('kdph');
			const examStatusList = document.getElementById('exam-status-list');

			function calculate() {
				const chars = Math.max(0, parseFloat(charInput?.value || '0'));
				const duration = Math.max(1, parseFloat(durationInput?.value || '10'));
				const full = Math.max(0, parseFloat(fullMistakesInput?.value || '0'));
				const half = Math.max(0, parseFloat(halfMistakesInput?.value || '0'));

				// 5 keystrokes = 1 word
				const totalWords = chars / 5;
				const grossWpm = totalWords / duration;

				const errorWords = full + (half * 0.5);
				const netWpm = Math.max(0, grossWpm - (errorWords / duration));

				const accuracy = totalWords > 0 ? Math.max(0, Math.min(100, ((totalWords - errorWords) / totalWords) * 100)) : 0;
				const kdph = Math.round((chars / duration) * 60);

				if (grossWpmEl) grossWpmEl.textContent = `${grossWpm.toFixed(1)} WPM`;
				if (netWpmEl) netWpmEl.textContent = `${netWpm.toFixed(1)} WPM`;
				if (accuracyEl) accuracyEl.textContent = `${accuracy.toFixed(1)}%`;
				if (kdphEl) kdphEl.textContent = kdph.toLocaleString();

				// Exam eligibility benchmarks
				const benchmarks = [
					{ name: 'SSC CHSL English (35 WPM / 10,500 KDPH)', pass: netWpm >= 35 && accuracy >= 90 },
					{ name: 'SSC CHSL Hindi (30 WPM / 9,000 KDPH)', pass: netWpm >= 30 && accuracy >= 90 },
					{ name: 'SSC CGL DEST (27 WPM / 8,000 KDPH)', pass: kdph >= 8000 && accuracy >= 93 },
					{ name: 'RRB NTPC English (35 WPM)', pass: netWpm >= 35 && accuracy >= 95 },
					{ name: 'High Court LDC / Typist (40 WPM)', pass: netWpm >= 40 && accuracy >= 95 },
					{ name: 'CRPF HCM English (35 WPM / 5% Error)', pass: netWpm >= 35 && accuracy >= 95 }
				];

				if (examStatusList) {
					examStatusList.innerHTML = benchmarks.map(b => `
						<div class="exam-status-item">
							<span>${b.name}</span>
							<span class="status-pill ${b.pass ? 'status-pass' : 'status-fail'}">
								${b.pass ? '✓ Qualified' : '✗ Need Practice'}
							</span>
						</div>
					`).join('');
				}
			}

			[charInput, durationInput, fullMistakesInput, halfMistakesInput].forEach(input => {
				input?.addEventListener('input', calculate);
			});

			// Initial calculation
			calculate();
		</script>
	</body>
</html>
