---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, allPosts: posts },
	}));
}

type Props = { post: CollectionEntry<'blog'>; allPosts: CollectionEntry<'blog'>[] };

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

function getCategory(id: string) {
	if (id.includes('court')) return 'high-court';
	if (id.includes('bsf') || id.includes('cisf') || id.includes('crpf') || id.includes('army') || id.includes('police')) return 'defense';
	if (id.includes('ssc') || id.includes('rrb') || id.includes('ntpc')) return 'central';
	if (id.includes('hindi') || id.includes('font') || id.includes('mangal') || id.includes('layout')) return 'hindi';
	return 'other';
}

const category = getCategory(post.id);
const relatedPosts = allPosts
	.filter((p) => p.id !== post.id && getCategory(p.id) === category)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<BlogPost {...post.data} body={post.body} postId={post.id} relatedPosts={relatedPosts} allPosts={allPosts}>
	<Content />
</BlogPost>
