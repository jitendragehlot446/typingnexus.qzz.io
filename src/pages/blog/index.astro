---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1280px;
				max-width: calc(100% - 2 * var(--spacing-xxl));
				margin: 0 auto;
			}
			.blog-header {
				margin-bottom: var(--spacing-xxl);
				border-bottom: 1px solid var(--colors-hairline);
				padding-bottom: var(--spacing-xl);
			}
			.blog-header .eyebrow {
				display: block;
				margin-bottom: var(--spacing-sm);
				opacity: 0.8;
			}
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: var(--spacing-lg);
				margin-bottom: var(--spacing-section);
			}
			@media (max-width: 768px) {
				.posts-grid {
					grid-template-columns: 1fr;
				}
			}
			.post-card {
				background-color: var(--colors-canvas);
				border: 1px solid var(--colors-hairline);
				border-radius: var(--rounded-lg);
				overflow: hidden;
				display: flex;
				flex-direction: column;
				transition: transform 0.2s ease, border-color 0.2s ease;
			}
			.post-card:hover {
				transform: translateY(-4px);
				border-color: var(--colors-primary);
			}
			.post-card a {
				text-decoration: none;
				color: inherit;
				display: flex;
				flex-direction: column;
				height: 100%;
			}
			.post-card img {
				width: 100%;
				aspect-ratio: 16/9;
				object-fit: cover;
				border: none;
				border-bottom: 1px solid var(--colors-hairline);
				border-radius: 0;
			}
			.post-card-body {
				padding: var(--spacing-lg);
				display: flex;
				flex-direction: column;
				flex: 1;
			}
			.post-card-body h3 {
				margin-bottom: var(--spacing-xs);
			}
			.post-card-body .date {
				margin-top: auto;
			}
			/* Hero card (first post) spans full width */
			.post-card.hero-post {
				grid-column: span 2;
			}
			@media (max-width: 768px) {
				.post-card.hero-post {
					grid-column: span 1;
				}
			}
			.post-card.hero-post a {
				flex-direction: row;
			}
			@media (max-width: 768px) {
				.post-card.hero-post a {
					flex-direction: column;
				}
			}
			.post-card.hero-post img {
				width: 50%;
				aspect-ratio: 16/9;
				border-bottom: none;
				border-right: 1px solid var(--colors-hairline);
			}
			@media (max-width: 768px) {
				.post-card.hero-post img {
					width: 100%;
					border-right: none;
					border-bottom: 1px solid var(--colors-hairline);
				}
			}
			.post-card.hero-post .post-card-body {
				justify-content: center;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="blog-header">
				<span class="eyebrow">Nexus Archives</span>
				<h1 class="display-lg">The Typing Blog</h1>
			</section>

			<section class="posts-grid">
				{
					posts.map((post, index) => (
						<article class={`post-card ${index === 0 ? 'hero-post' : ''}`}>
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && (
									<img src={post.data.heroImage} alt="" />
								)}
								<div class="post-card-body">
									<h3 class={index === 0 ? "display-lg" : "card-title"}>{post.data.title}</h3>
									<span class="caption date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</div>
							</a>
						</article>
					))
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
