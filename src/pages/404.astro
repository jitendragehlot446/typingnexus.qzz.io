---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Page Not Found | Typing Nexus Blog" description="The page you are looking for does not exist. Browse our typing exam guides." />
		<meta name="robots" content="noindex" />
		<style>
			.error-page {
				text-align: center;
				padding: var(--spacing-section) var(--spacing-md);
				max-width: 600px;
				margin: 0 auto;
			}
			.error-page h1 {
				font-size: 96px;
				font-weight: 200;
				margin-bottom: var(--spacing-md);
				color: var(--colors-primary);
			}
			.error-page p {
				font-size: 18px;
				margin-bottom: var(--spacing-xl);
				opacity: 0.8;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="error-page">
				<h1>404</h1>
				<p>The page you are looking for does not exist or has been moved.</p>
				<a href="/" class="button-primary">Go Home</a>
				<a href="/blog" class="button-secondary">Browse Guides</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
