---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				text-align: center;
				padding: var(--spacing-section) var(--spacing-md) calc(var(--spacing-section) * 1.5);
				background-color: var(--colors-canvas);
			}
			.hero .eyebrow {
				color: var(--colors-primary);
				margin-bottom: var(--spacing-md);
				display: block;
			}
			.hero h1, .hero .hero-title {
				margin-bottom: var(--spacing-lg);
				max-width: 900px;
				margin-left: auto;
				margin-right: auto;
			}
			.hero p {
				color: var(--colors-primary);
				max-width: 680px;
				margin: 0 auto var(--spacing-xl);
			}
			.cta-buttons {
				display: flex;
				justify-content: center;
				gap: var(--spacing-md);
			}

			/* Marquee Strip */
			.marquee-strip {
				background-color: var(--colors-inverse-canvas);
				color: var(--colors-on-primary);
				height: 48px;
				overflow: hidden;
				display: flex;
				align-items: center;
				white-space: nowrap;
				border-top: 1px solid var(--colors-primary);
				border-bottom: 1px solid var(--colors-primary);
			}
			.marquee-content {
				display: inline-flex;
				animation: marquee 25s linear infinite;
				gap: var(--spacing-xl);
				padding-left: var(--spacing-xl);
			}
			.marquee-item {
				font-family: var(--font-mono);
				font-size: 14px;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				font-weight: 500;
			}
			@keyframes marquee {
				0% { transform: translateX(0%); }
				100% { transform: translateX(-50%); }
			}

			/* Color Block Section Specific overrides */
			.block-content {
				max-width: 720px;
				margin: 0 auto;
				text-align: center;
			}
			.block-content .eyebrow {
				margin-bottom: var(--spacing-md);
				display: block;
				opacity: 0.8;
			}
			.block-content h2 {
				margin-bottom: var(--spacing-md);
			}
			.block-content p {
				margin-bottom: var(--spacing-xl);
			}

			/* Grid layout for white canvas cards */
			.section-heading {
				margin-top: var(--spacing-section);
				margin-bottom: var(--spacing-xl);
				border-bottom: 1px solid var(--colors-hairline);
				padding-bottom: var(--spacing-sm);
				display: flex;
				justify-content: space-between;
				align-items: flex-end;
			}
			.section-heading h2 {
				margin-bottom: 0;
			}
			.section-heading a {
				font-family: var(--font-sans);
				font-size: 16px;
				font-weight: 540;
				text-decoration: none;
			}
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: var(--spacing-lg);
				margin-bottom: var(--spacing-section);
			}
			@media (max-width: 960px) {
				.posts-grid {
					grid-template-columns: 1fr;
				}
			}
			.post-card {
				background-color: var(--colors-canvas);
				border: 1px solid var(--colors-hairline);
				border-radius: var(--rounded-lg);
				overflow: hidden;
				display: flex;
				flex-direction: column;
				transition: transform 0.2s ease, border-color 0.2s ease;
			}
			.post-card:hover {
				transform: translateY(-4px);
				border-color: var(--colors-primary);
			}
			.post-card a {
				text-decoration: none;
				color: inherit;
				display: flex;
				flex-direction: column;
				height: 100%;
			}
			.post-card-image-container {
				position: relative;
				width: 100%;
				aspect-ratio: 16/9;
				overflow: hidden;
				border-bottom: 1px solid var(--colors-hairline);
			}
			.post-card-image-container img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}
			.post-card-badge {
				position: absolute;
				top: var(--spacing-sm);
				left: var(--spacing-sm);
				background: rgba(255, 255, 255, 0.85);
				backdrop-filter: blur(8px);
				-webkit-backdrop-filter: blur(8px);
				border: 1px solid rgba(255, 255, 255, 0.4);
				color: var(--colors-primary);
				padding: 4px 10px;
				font-family: var(--font-mono);
				font-size: 11px;
				font-weight: 600;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				border-radius: var(--rounded-pill);
				box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
				z-index: 2;
			}
			.post-card-body {
				padding: var(--spacing-lg);
				display: flex;
				flex-direction: column;
				flex: 1;
			}
			.post-card-body h3 {
				margin-bottom: var(--spacing-xs);
			}
			.post-card-body .date {
				margin-top: auto;
			}
		</style>
	</head>
	<body>
		<Header />
		
		<section class="hero">
			<span class="eyebrow">Introducing Typing Nexus</span>
			<h1 style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0;">Typing Nexus</h1>
			<div class="display-xl hero-title">Type faster. Write smarter.</div>
			<p class="body-lg">
				The ultimate online practice portal for Indian government typing examinations. Master speed and accuracy for UP Police, SSC CHSL, DSSSB, High Courts, and more.
			</p>
			<div class="cta-buttons">
				<a href="https://typingnexus.in" target="_blank" class="button-primary">Try a mock test</a>
				<a href="/blog" class="button-secondary">Read Guides</a>
			</div>
		</section>

		<div class="marquee-strip">
			<div class="marquee-content">
				<span class="marquee-item">SSC CHSL</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">RRB NTPC</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">SSC CGL</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">UP POLICE ASI</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">DELHI POLICE HC</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">HIGH COURT LDC</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">DSSSB LDC</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">RSMSSB LDC</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">ARMY CLERK</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">CISF HC</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">BSF HC</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">CRPF ASI</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">PATNA HIGH COURT</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">ALLAHABAD HIGH COURT</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">SSC CHSL</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">RRB NTPC</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">SSC CGL</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">UP POLICE ASI</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">DELHI POLICE HC</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">HIGH COURT LDC</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">DSSSB LDC</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">RSMSSB LDC</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">ARMY CLERK</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">CISF HC</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">BSF HC</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">CRPF ASI</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">PATNA HIGH COURT</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">ALLAHABAD HIGH COURT</span>
			</div>
		</div>

		<main>
			<!-- Lilac Block -->
			<section class="color-block color-block-lilac">
				<div class="block-content">
					<span class="eyebrow">Layout Ergonomics</span>
					<h2 class="display-lg">Ergonomic keymaps.</h2>
					<p class="body">
						Learn how modern layouts like Colemak and Dvorak reduce finger travel distance by up to 60%, preventing repetitive strain injuries (RSI) while boosting typing speed.
					</p>
					<a href="/blog" class="button-primary">Learn Layouts</a>
				</div>
			</section>

			<!-- Mint Block -->
			<section class="color-block color-block-mint">
				<div class="block-content">
					<span class="eyebrow">Exam Preparation</span>
					<h2 class="display-lg">Exact exam simulations.</h2>
					<p class="body">
						Practice on interfaces that exactly mirror exams like UP Police, SSC CHSL, DSSSB, Supreme Court JCA, and High Court LDC. Configure custom settings including Remington Gail, Inscript, or Krutidev, and toggle disabled backspace options.
					</p>
					<a href="https://typingnexus.in" target="_blank" class="button-primary">Try exam simulations</a>
				</div>
			</section>

			<!-- Navy Block (Dark) -->
			<section class="color-block color-block-navy">
				<div class="block-content">
					<span class="eyebrow">Performance Metrics</span>
					<h2 class="display-lg">Analyze your mistakes.</h2>
					<p class="body">
						Track your typing speed (WPM) and accuracy in real-time. Typing Nexus maps your errors and highlights specific bottleneck keys and mistyped combinations to help you optimize your speed for competitive exams.
					</p>
					<a href="https://typingnexus.in" target="_blank" class="button-secondary">Analyze your typing</a>
				</div>
			</section>

			<!-- Recent Posts Grid (White Canvas) -->
			<section class="section-heading">
				<h2 class="headline">Recent Blog Posts</h2>
				<a href="/blog">View all posts &rarr;</a>
			</section>

			<section class="posts-grid">
				{
					posts.map((post) => (
						<article class="post-card">
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && (
									<div class="post-card-image-container">
										<Image src={post.data.heroImage} alt={post.data.imageAlt || `${post.data.examName} typing test rules`} width={720} height={360} />
										{post.data.examName && <span class="post-card-badge">{post.data.examName}</span>}
									</div>
								)}
								<div class="post-card-body">
									<h3 class="card-title">{post.data.title}</h3>
									<span class="caption date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</div>
							</a>
						</article>
					))
				}
			</section>
		</main>

		<Footer />
	</body>
</html>
