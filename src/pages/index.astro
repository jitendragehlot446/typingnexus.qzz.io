---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				text-align: center;
				padding: var(--spacing-section) var(--spacing-md) calc(var(--spacing-section) * 1.5);
				background-color: var(--colors-canvas);
			}
			.hero .eyebrow {
				color: var(--colors-primary);
				margin-bottom: var(--spacing-md);
				display: block;
			}
			.hero h1 {
				margin-bottom: var(--spacing-lg);
				max-width: 900px;
				margin-left: auto;
				margin-right: auto;
			}
			.hero p {
				color: var(--colors-primary);
				max-width: 680px;
				margin: 0 auto var(--spacing-xl);
			}
			.cta-buttons {
				display: flex;
				justify-content: center;
				gap: var(--spacing-md);
			}

			/* Marquee Strip */
			.marquee-strip {
				background-color: var(--colors-inverse-canvas);
				color: var(--colors-on-primary);
				height: 48px;
				overflow: hidden;
				display: flex;
				align-items: center;
				white-space: nowrap;
				border-top: 1px solid var(--colors-primary);
				border-bottom: 1px solid var(--colors-primary);
			}
			.marquee-content {
				display: inline-flex;
				animation: marquee 25s linear infinite;
				gap: var(--spacing-xl);
				padding-left: var(--spacing-xl);
			}
			.marquee-item {
				font-family: var(--font-mono);
				font-size: 14px;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				font-weight: 500;
			}
			@keyframes marquee {
				0% { transform: translateX(0%); }
				100% { transform: translateX(-50%); }
			}

			/* Color Block Section Specific overrides */
			.block-content {
				max-width: 720px;
				margin: 0 auto;
				text-align: center;
			}
			.block-content .eyebrow {
				margin-bottom: var(--spacing-md);
				display: block;
				opacity: 0.8;
			}
			.block-content h2 {
				margin-bottom: var(--spacing-md);
			}
			.block-content p {
				margin-bottom: var(--spacing-xl);
			}

			/* Grid layout for white canvas cards */
			.section-heading {
				margin-top: var(--spacing-section);
				margin-bottom: var(--spacing-xl);
				border-bottom: 1px solid var(--colors-hairline);
				padding-bottom: var(--spacing-sm);
				display: flex;
				justify-content: space-between;
				align-items: flex-end;
			}
			.section-heading h2 {
				margin-bottom: 0;
			}
			.section-heading a {
				font-family: var(--font-sans);
				font-size: 16px;
				font-weight: 540;
				text-decoration: none;
			}
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: var(--spacing-lg);
				margin-bottom: var(--spacing-section);
			}
			@media (max-width: 960px) {
				.posts-grid {
					grid-template-columns: 1fr;
				}
			}
			.post-card {
				background-color: var(--colors-canvas);
				border: 1px solid var(--colors-hairline);
				border-radius: var(--rounded-lg);
				overflow: hidden;
				display: flex;
				flex-direction: column;
				transition: transform 0.2s ease, border-color 0.2s ease;
			}
			.post-card:hover {
				transform: translateY(-4px);
				border-color: var(--colors-primary);
			}
			.post-card a {
				text-decoration: none;
				color: inherit;
				display: flex;
				flex-direction: column;
				height: 100%;
			}
			.post-card img {
				width: 100%;
				aspect-ratio: 16/9;
				object-fit: cover;
				border: none;
				border-bottom: 1px solid var(--colors-hairline);
				border-radius: 0;
			}
			.post-card-body {
				padding: var(--spacing-lg);
				display: flex;
				flex-direction: column;
				flex: 1;
			}
			.post-card-body h3 {
				margin-bottom: var(--spacing-xs);
			}
			.post-card-body .date {
				margin-top: auto;
			}
		</style>
	</head>
	<body>
		<Header />
		
		<section class="hero">
			<span class="eyebrow">Introducing Typing Nexus</span>
			<h1 class="display-xl">Type faster. Write smarter.</h1>
			<p class="body-lg">
				The professional way to optimize keyboard layout efficiency, build muscle memory, and master typing cadence with curated developer resources.
			</p>
			<div class="cta-buttons">
				<a href="/blog" class="button-primary">Read Blogs</a>
				<a href="https://github.com/jitendragehlot446" target="_blank" class="button-secondary">GitHub Profile</a>
			</div>
		</section>

		<div class="marquee-strip">
			<div class="marquee-content">
				<span class="marquee-item">QWERTY</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">COLEMAK</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">DVORAK</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">WORKMAN</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">AZERTY</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">HALMAK</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">QWERTZ</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">QWERTY</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">COLEMAK</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">DVORAK</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">WORKMAN</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">AZERTY</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">HALMAK</span>
				<span class="marquee-item">·</span>
				<span class="marquee-item">QWERTZ</span>
			</div>
		</div>

		<main>
			<!-- Lilac Block -->
			<section class="color-block color-block-lilac">
				<div class="block-content">
					<span class="eyebrow">Layout Ergonomics</span>
					<h2 class="display-lg">Ergonomic keymaps.</h2>
					<p class="body">
						Learn how modern layouts like Colemak and Dvorak reduce finger travel distance by up to 60%, preventing repetitive strain injuries (RSI) while boosting typing speed.
					</p>
					<a href="/blog" class="button-primary">Learn Layouts</a>
				</div>
			</section>

			<!-- Mint Block -->
			<section class="color-block color-block-mint">
				<div class="block-content">
					<span class="eyebrow">Tactile Guides</span>
					<h2 class="display-lg">Switches & Caps.</h2>
					<p class="body">
						From Cherry to tactile custom mechanical keys, select the ideal actuation force and travel distance to perfect your personal writing cadence.
					</p>
					<a href="/blog" class="button-primary">Read Switch Guide</a>
				</div>
			</section>

			<!-- Navy Block (Dark) -->
			<section class="color-block color-block-navy">
				<div class="block-content">
					<span class="eyebrow">Keystroke signature</span>
					<h2 class="display-lg">Data-driven typing.</h2>
					<p class="body">
						Track your typing bursts, analyze layouts, and map mechanical bottlenecks with clean, minimalist data structures.
					</p>
					<a href="https://github.com/jitendragehlot446/typingnexus.qzz.io" target="_blank" class="button-secondary">Explore Project Repo</a>
				</div>
			</section>

			<!-- Recent Posts Grid (White Canvas) -->
			<section class="section-heading">
				<h2 class="headline">Recent Blog Posts</h2>
				<a href="/blog">View all posts &rarr;</a>
			</section>

			<section class="posts-grid">
				{
					posts.map((post) => (
						<article class="post-card">
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && (
									<img src={post.data.heroImage} alt="" />
								)}
								<div class="post-card-body">
									<h3 class="card-title">{post.data.title}</h3>
									<span class="caption date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</div>
							</a>
						</article>
					))
				}
			</section>
		</main>

		<Footer />
	</body>
</html>
